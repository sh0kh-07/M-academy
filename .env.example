# Copy to .env.local if needed. Nothing here is required for local work.

# Where the browser sends API requests. Leave empty to use /api on the same domain
# (Vite proxies /api and /uploads in dev/preview; in production nginx should proxy both
# to the backend — /uploads holds the course images and videos).
# If the API lives on another domain, put its full URL here and ask the backend
# to allow the site's origin in CORS:
# VITE_API_URL=https://dev-m-academy.udsgroup.uz/api

# Backend that `npm run dev` / `npm run preview` proxy /api to (not shipped to the browser):
# API_TARGET=https://dev-m-academy.udsgroup.uz
